@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix rdfc: <https://w3id.org/conn/js#>.
@prefix fno: <https://w3id.org/function/ontology#>.
@prefix fnom: <https://w3id.org/function/vocabulary/mapping#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <https://w3id.org/conn#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix dc: <http://purl.org/dc/terms/>.
@prefix rdfc: <https://w3id.org/rdf-connect#>.

rdfc:Sdsify a owl:Class, rdfs:Class;
  rdfc:jsImplementationOf rdfc:Processor;
  rdfs:label "Sdsify processor";
  rdfs:description "Ingest a stream of RDF dumps and produce a stream of SDS records, based on the provided configuration.";
  rdfc:file <../lib/sdsify.js>;
  rdfc:class "Sdsify";
  rdfc:entrypoint <../>.

[ ] a sh:NodeShape;
  sh:targetClass rdfc:Sdsify;
  sh:property [
    sh:class rdfc:Reader;
    sh:path rdfc:input;
    sh:name "input";
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:class rdfc:Writer;
    sh:path rdfc:output;
    sh:name "output";
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:class rdfc:Writer;
    sh:path rdfc:metadataOutput;
    sh:name "metadataOutput";
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:class rdfc:MetadataConfig;
    sh:path rdfc:metadataConfig;
    sh:name "metadataConfig";
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:datatype xsd:iri;
    sh:path rdfc:typeFilter;
    sh:name "types";
    sh:minCount 0;
  ], [
    sh:datatype xsd:string;
    sh:path rdfc:shape;
    sh:name "shape";
    sh:minCount 0;
    sh:maxCount 1;
  ], [
    sh:datatype xsd:boolean;
    sh:path rdfc:readAsStream;
    sh:name "readAsStream";
    sh:minCount 0;
    sh:maxCount 1;
  ].

[ ] a sh:NodeShape;
  sh:targetClass rdfc:MetadataConfig;
  sh:property [
    sh:datatype xsd:iri;
    sh:path rdfc:streamId;
    sh:name "streamId";
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:datatype xsd:string;
    sh:path rdfc:description;
    sh:name "description";
    sh:maxCount 1;
  ], [
    sh:datatype xsd:iri;
    sh:path rdfc:timestampPath;
    sh:name "timestampPath";
    sh:maxCount 1;
  ], [
    sh:datatype xsd:iri;
    sh:path rdfc:versionOfPath;
    sh:name "versionOfPath";
    sh:maxCount 1;
  ], [
    sh:datatype xsd:iri;
    sh:path rdfc:shapeIri;
    sh:name "shapeIri";
    sh:maxCount 1;
  ],[
    sh:datatype xsd:string;
    sh:path rdfc:shape;
    sh:name "shape";
    sh:maxCount 1;
  ].